{
  "name": "@linkrunner/appbrew",
  "version": "0.3.1",
  "description": "Linkrunner attribution for Appbrew apps: installs, in-app events, revenue, deep links and push notification opens.",
  "license": "MIT",
  "author": "Linkrunner <support@linkrunner.io>",
  "homepage": "https://docs.linkrunner.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linkrunner-labs/linkrunner-appbrew.git"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "appbrew-integration",
    "linkrunner",
    "attribution",
    "mmp",
    "deep-linking",
    "react-native"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "tsc --noEmit -p tsconfig.ci.json"
  },
  "peerDependencies": {
    "rn-linkrunner": ">=3.4.1",
    "react-native": "*",
    "@gauntlet/analytics": "*",
    "@gauntlet/brewery": "*",
    "@gauntlet/local-storage": "*",
    "@gauntlet/state": "*",
    "@gauntlet/types": "*",
    "@react-native-firebase/messaging": "*",
    "@react-native-firebase/analytics": "*",
    "clevertap-react-native": "*",
    "@gauntlet/firebase-push": "*",
    "@notifee/react-native": "*"
  },
  "peerDependenciesMeta": {
    "@gauntlet/analytics": {
      "optional": true
    },
    "@gauntlet/brewery": {
      "optional": true
    },
    "@gauntlet/local-storage": {
      "optional": true
    },
    "@gauntlet/state": {
      "optional": true
    },
    "@gauntlet/types": {
      "optional": true
    },
    "@react-native-firebase/messaging": {
      "optional": true
    },
    "@react-native-firebase/analytics": {
      "optional": true
    },
    "clevertap-react-native": {
      "optional": true
    },
    "@gauntlet/firebase-push": {
      "optional": true
    },
    "@notifee/react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "rn-linkrunner": "3.4.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "appbrew": {
    "title": "Linkrunner",
    "access": "self-serve",
    "image": "https://linkrunner.io/brand/logos/linkrunner-mark-color.png",
    "configKey": "linkrunner",
    "requiresNativeBuild": true,
    "settings": [
      {
        "key": "token",
        "title": "Linkrunner Project Token",
        "type": "text",
        "required": true,
        "secret": true,
        "placeholder": "Linkrunner dashboard → Settings → Project Details → Project token"
      },
      {
        "key": "secretKey",
        "title": "Secret Key (SDK signing)",
        "type": "text",
        "required": false,
        "secret": true,
        "placeholder": "Only if SDK signing is on: Linkrunner dashboard → Settings → SDK Signing"
      },
      {
        "key": "keyId",
        "title": "Key ID (SDK signing)",
        "type": "text",
        "required": false,
        "secret": false,
        "placeholder": "Only if SDK signing is on: Linkrunner dashboard → Settings → SDK Signing"
      },
      {
        "key": "debug",
        "title": "Debug Logging (testing only, turn off before release)",
        "type": "boolean",
        "required": false
      },
      {
        "key": "disableIdfa",
        "title": "Disable IDFA (iOS)",
        "type": "boolean",
        "required": false
      },
      {
        "key": "enablePIIHashing",
        "title": "Hash PII Before Sending",
        "type": "boolean",
        "required": false
      },
      {
        "key": "trackScreenViews",
        "title": "Forward Screen View Events",
        "type": "boolean",
        "required": false
      },
      {
        "key": "deeplinkRouting",
        "title": "Route Deferred Deep Links",
        "type": "boolean",
        "required": false
      },
      {
        "key": "uninstallTracking",
        "title": "Uninstall Tracking",
        "type": "boolean",
        "required": false
      },
      {
        "key": "pushOpenAttribution",
        "title": "Push Open Attribution",
        "type": "boolean",
        "required": false
      },
      {
        "key": "enableRefunds",
        "title": "Forward Refunds",
        "type": "boolean",
        "required": false
      },
      {
        "key": "consentIsEEA",
        "title": "Google Ads Consent (EEA User)",
        "type": "text",
        "required": false,
        "secret": false,
        "placeholder": "granted, denied or unknown. Leave empty if your app has a consent banner"
      },
      {
        "key": "consentAdUserData",
        "title": "Google Ads Consent (Ad User Data)",
        "type": "text",
        "required": false,
        "secret": false,
        "placeholder": "granted, denied or unknown. Leave empty if your app has a consent banner"
      },
      {
        "key": "consentAdPersonalization",
        "title": "Google Ads Consent (Ad Personalization)",
        "type": "text",
        "required": false,
        "secret": false,
        "placeholder": "granted, denied or unknown. Leave empty if your app has a consent banner"
      },
      {
        "key": "enableTCFConsentCollection",
        "title": "Read TCF Consent From CMP (Android)",
        "type": "boolean",
        "required": false
      },
      {
        "key": "clevertapIntegration",
        "title": "Link CleverTap ID",
        "type": "boolean",
        "required": false
      },
      {
        "key": "analyticsIdentifiers",
        "title": "Attach Firebase Analytics IDs",
        "type": "boolean",
        "required": false
      },
      {
        "key": "eventsMapper",
        "title": "Events Mapper (JSON)",
        "type": "json",
        "required": false,
        "secret": false,
        "placeholder": "{\"add_to_cart\": \"AddToCart\"}. Leave empty to send Appbrew event names as is"
      },
      {
        "key": "paramsMapper",
        "title": "Params Mapper (JSON)",
        "type": "json",
        "required": false,
        "secret": false,
        "placeholder": "{\"value\": \"amount\"}. Leave empty to send Appbrew param names as is"
      },
      {
        "key": "eventsWhitelist",
        "title": "Events Whitelist (JSON array)",
        "type": "json",
        "required": false,
        "secret": false,
        "placeholder": "[\"purchase\", \"add_to_cart\"]. Leave empty to send every event"
      },
      {
        "key": "paramsWhitelist",
        "title": "Params Whitelist (JSON array)",
        "type": "json",
        "required": false,
        "secret": false,
        "placeholder": "[\"value\", \"currency\", \"items\"]. Leave empty to send every param"
      }
    ]
  }
}
