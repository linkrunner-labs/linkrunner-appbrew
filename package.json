{
  "name": "@linkrunner/appbrew",
  "version": "0.1.6",
  "description": "Linkrunner attribution for Appbrew apps \u2014 installs, in-app events, revenue, and deep links.",
  "license": "MIT",
  "author": "Linkrunner <support@linkrunner.io>",
  "homepage": "https://docs.linkrunner.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linkrunner-labs/linkrunner-appbrew.git"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "appbrew-integration",
    "linkrunner",
    "attribution",
    "mmp",
    "deep-linking",
    "react-native"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "tsc --noEmit -p tsconfig.ci.json"
  },
  "peerDependencies": {
    "rn-linkrunner": ">=3.0.0",
    "react-native": "*",
    "@gauntlet/analytics": "*",
    "@gauntlet/brewery": "*",
    "@gauntlet/local-storage": "*",
    "@gauntlet/state": "*",
    "@gauntlet/types": "*",
    "@react-native-firebase/messaging": "*"
  },
  "peerDependenciesMeta": {
    "@gauntlet/analytics": {
      "optional": true
    },
    "@gauntlet/brewery": {
      "optional": true
    },
    "@gauntlet/local-storage": {
      "optional": true
    },
    "@gauntlet/state": {
      "optional": true
    },
    "@gauntlet/types": {
      "optional": true
    },
    "@react-native-firebase/messaging": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "appbrew": {
    "configKey": "linkrunner",
    "requiresNativeBuild": true,
    "settings": [
      {
        "key": "token",
        "title": "Linkrunner Project Token",
        "placeholder": "token",
        "secret": true,
        "type": "text",
        "required": true
      },
      {
        "key": "secretKey",
        "title": "Secret Key (SDK signing)",
        "placeholder": "secretKey",
        "secret": true,
        "required": false,
        "type": "text"
      },
      {
        "key": "keyId",
        "title": "Key ID (SDK signing)",
        "placeholder": "keyId",
        "required": false,
        "type": "text"
      },
      {
        "key": "debug",
        "title": "Debug Logging",
        "required": false,
        "type": "boolean"
      },
      {
        "key": "disableIdfa",
        "title": "Disable IDFA (iOS)",
        "required": false,
        "type": "boolean"
      },
      {
        "key": "enablePIIHashing",
        "title": "Hash PII Before Sending",
        "required": false,
        "type": "boolean"
      },
      {
        "key": "trackScreenViews",
        "title": "Forward Screen View Events",
        "required": false,
        "type": "boolean"
      },
      {
        "key": "deeplinkRouting",
        "title": "Route Deferred Deep Links",
        "required": false,
        "type": "boolean"
      },
      {
        "key": "uninstallTracking",
        "title": "Uninstall Tracking",
        "required": false,
        "type": "boolean"
      },
      {
        "key": "enableRefunds",
        "title": "Forward Refunds",
        "required": false,
        "type": "boolean"
      },
      {
        "key": "eventsMapper",
        "title": "Events Mapper (JSON)",
        "required": false,
        "type": "text"
      },
      {
        "key": "paramsMapper",
        "title": "Params Mapper (JSON)",
        "required": false,
        "type": "text"
      },
      {
        "key": "eventsWhitelist",
        "title": "Events Whitelist (JSON array)",
        "required": false,
        "type": "text"
      },
      {
        "key": "paramsWhitelist",
        "title": "Params Whitelist (JSON array)",
        "required": false,
        "type": "text"
      }
    ]
  }
}
